# Copy to keystore.properties (gitignored) and fill in the real values.
# The whole com.termux shared-UID family (shiroikuma-emacs, -termux, -termux-api,
# -termux-x11, -termux-gui) signs with ONE keystore; the alias may contain spaces.
storeFile=/home/you/.android-keystores/your-keystore.jks
storePassword=123456
keyAlias=my alias
keyPassword=abcdef
