<?xml version="1.0" encoding="utf-8"?>
<!-- Panel of the platform AlertDialogs raised from the 白い熊 GNU Emacs
     UI page: black, 2 dp yellow border, 12 dp corners (the house
     dialog look).  Part of the shiroikuma-emacs fork.  -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
       android:insetLeft="16dp"
       android:insetTop="16dp"
       android:insetRight="16dp"
       android:insetBottom="16dp">
  <shape android:shape="rectangle">
    <solid android:color="#FF000000"/>
    <stroke android:width="2dp" android:color="#FFFFFF00"/>
    <corners android:radius="12dp"/>
  </shape>
</inset>
