<resources>
  <!-- The house look: black ground, yellow ink, black system bars.
       Theme.DeviceDefault (not .DayNight) is the dark Material theme
       on every supported API level (minSdk 29).  -->
  <style name="ShiroikumaStyle"
	 parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:colorBackground">@android:color/black</item>
    <item name="android:statusBarColor">@android:color/black</item>
    <item name="android:navigationBarColor">@android:color/black</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:colorAccent">#FFFFFF00</item>
    <item name="android:colorPrimary">@android:color/black</item>
    <item name="android:colorPrimaryDark">@android:color/black</item>
    <item name="android:textColorPrimary">#FFFFFF00</item>
    <item name="android:textColorSecondary">#FFC8C800</item>
    <item name="android:textColorTertiary">#FFC8C800</item>
    <item name="android:alertDialogTheme">@style/ShiroikumaDialog</item>
    <item name="android:windowSwipeToDismiss">false</item>
  </style>

  <!-- Platform AlertDialogs raised from the page (confirmations, the
       backup list): black panel with a 2 dp yellow border, yellow text
       everywhere, yellow buttons.  -->
  <style name="ShiroikumaDialog"
	 parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
    <item name="android:windowBackground">@drawable/shiroikuma_dialog_bg</item>
    <item name="android:colorBackground">@android:color/black</item>
    <item name="android:colorAccent">#FFFFFF00</item>
    <item name="android:textColorPrimary">#FFFFFF00</item>
    <item name="android:textColorSecondary">#FFC8C800</item>
    <item name="android:textColorAlertDialogListItem">#FFFFFF00</item>
    <item name="android:textColor">#FFFFFF00</item>
  </style>
</resources>
